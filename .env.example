# =============================================================================
# Agency Cortex - Ortam Degiskenleri (ORNEK)
# =============================================================================
# Bu dosya sablondur. Gercek degerler `.env` dosyasina yazilir.
# `.env` dosyasi ASLA git'e gonderilmez (.gitignore icinde).
# Hangi degerin nereden alinacagi icin: CREDENTIALS.md
# =============================================================================

# --- Genel ---
APP_ENV=development              # development | staging | production
APP_NAME=Agency Cortex
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
TZ=Europe/Istanbul

# --- Guvenlik ---
# Asagidakileri uretimde MUTLAKA degistirin. Uretme komutu icin CREDENTIALS.md
SECRET_KEY=degistir-bu-degeri-uretimde
ENCRYPTION_KEY=degistir-bu-degeri-uretimde
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- PostgreSQL (veritabani) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agency_cortex
POSTGRES_USER=agency
POSTGRES_PASSWORD=degistir-bu-degeri-uretimde
# Testler AYRI bir veritabaninda calisir; uretim verisi asla ezilmez.
POSTGRES_TEST_DB=agency_cortex_test

# --- Redis (kuyruk) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Web ---
PUBLIC_DOMAIN=agencycortex.tech
# Caddy HTTPS sertifikasi icin gerekli. Sertifika yenilenmezse buraya bakin.
ACME_EMAIL=degistir@example.com
CORS_ORIGINS=http://localhost:5173

# --- AI saglayicilari ---
# Anahtar YOKSA sistem sahte (fake) saglayici ile calisir. Gelistirme icin yeterli.
AI_PROVIDER_MODE=fake           # fake | live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
MANUS_API_KEY=
MANUS_WEBHOOK_SECRET=
GEMINI_API_KEY=

# --- AI butce siniri (musteri basina, aylik, USD) ---
AI_MONTHLY_BUDGET_USD=50
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=120

# --- Platform adaptorleri ---
# fake: gercek hesap olmadan gelistirme (varsayilan)
# live: gercek Instagram/Facebook API (Meta uygulama incelemesi gerekir)
PLATFORM_MODE=fake

# --- Meta / Instagram ---
# Giris modeli: instagram_login VEYA facebook_login. Ikisi birlikte kullanilmaz.
# instagram_login : Instagram profesyonel hesabini dogrudan baglar (onerilen)
# facebook_login  : Instagram hesabi + bagli Facebook Page gerektirir
META_LOGIN_MODE=instagram_login

# Meta App Dashboard -> Ayarlar -> Temel
META_APP_ID=
META_APP_SECRET=

# ASAGIDAKI ADRESLER SISTEM TARAFINDAN URETILDI.
# Meta App Dashboard'a BIREBIR AYNI sekilde girilmelidir.
# Sondaki egik cizgi farki bile OAuth hatasina yol acar.
META_REDIRECT_URI=https://agencycortex.tech/api/v1/oauth/meta/callback
META_DEAUTHORIZE_CALLBACK_URL=https://agencycortex.tech/api/v1/oauth/meta/deauthorize
META_DATA_DELETION_REQUEST_URL=https://agencycortex.tech/api/v1/oauth/meta/data-deletion
META_WEBHOOK_CALLBACK_URL=https://agencycortex.tech/api/v1/webhooks/meta

# Webhook guvenligi
# VERIFY_TOKEN: siz belirlersiniz, Meta paneline de ayni deger girilir
# APP_SECRET  : Meta uygulamasindan alinir, gizli tutulur
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=

# -----------------------------------------------------------------------
# DIKKAT: Asagidaki 4 deger RESMI META DOKUMANINDAN dogrulanmadan
# doldurulmamalidir. Bos birakildiginda sistem canli moda GECMEZ ve
# acik hata verir. Tahminle deger yazmak, sessizce yanlis veri uretir.
# Doldurulacak degerler ve kaynaklari: docs/platforms/meta.md
# -----------------------------------------------------------------------
META_API_VERSION=
META_AUTHORIZE_URL=
META_TOKEN_URL=
META_GRAPH_BASE_URL=
META_SCOPES=

# Yalnizca META_LOGIN_MODE=facebook_login secilirse gerekir
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_REDIRECT_URI=
META_BUSINESS_ID=
META_PAGE_ID=

# OAuth state gecerlilik suresi (saniye) - sahte istek korumasi
OAUTH_STATE_TTL_SECONDS=600

# --- Guvenlik anahtarlari (yayin kilidi) ---
# ILK SURUMDE KAPALI KALMALI. Insan onayi olmadan paylasim yapilamaz.
FEATURE_PUBLISHING_ENABLED=false
FEATURE_COMMENT_REPLY_ENABLED=false
FEATURE_DM_ENABLED=false
