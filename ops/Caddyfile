# Caddy: HTTPS sertifikasini otomatik alir ve yeniler.
# Elle sertifika yonetimi gerekmez.

{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode gzip

	# Guvenlik basliklari
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		reverse_proxy api:8000
	}

	handle /readyz {
		reverse_proxy api:8000
	}

	handle /version {
		reverse_proxy api:8000
	}

	# Kok adres panele yonlendirilir.
	handle / {
		redir * /panel 302
	}

	# Panel ve diger tum yollar uygulamaya gider (Asama 7'de eklendi).
	handle {
		reverse_proxy api:8000
	}
}
